# Tailscale OAuth Client（推荐，最小权限）
TAILSCALE_OAUTH_CLIENT_ID=your-client-id
TAILSCALE_OAUTH_CLIENT_SECRET=your-client-secret
# 已弃用：全权限 API key，仅作回退
# TAILSCALE_API_KEY=tskey-api-xxx
TAILSCALE_TAILNET=example.ts.net
DOMAIN_SUFFIX=ts.example.com
TECHNITIUM_URL=http://technitium:5380
# compose.yml 使用；完整 Technitium 示例会自动创建 Token
TECHNITIUM_TOKEN=your-non-expiring-api-token
DNS_TTL=60

# compose.with-technitium.yml 首次初始化使用
TECHNITIUM_ADMIN_PASSWORD=change-me
# TECHNITIUM_ADMIN_USER=admin
# TECHNITIUM_TOKEN_NAME=tailscale-dns-sync
# TECHNITIUM_ENABLE_BLOCKING=false
# TECHNITIUM_BLOCK_LIST_URLS=https://example.com/blocklist.txt

# CRON_SCHEDULE=0 * * * *
# TRIGGER_TOKEN=your-random-token
# PORT=3001
# TAILSCALE_IP=127.0.0.1
